generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// اصلاحیه‌های محتوایی پنل مدیریت موزه
// گردش کار: pending_review → approved → applied (نقش تاریخ‌نگار در محیط عملیاتی)
model ContentEdit {
  id        String   @id @default(cuid())
  targetId  String // شناسه پرونده (عملیات/رویداد/…)
  note      String // متن اصلاحیه یا ادعای منبع‌دار جدید
  status    String   @default("pending_review")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// لاگ رویدادهای موزه (امنیت و ردیابی)
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

// ─── فاز ۱۴: مرورهای کارشناسی تصاویر مزار ───
// مهاجرت کامل از db/mazar-reviews.json به جدول واقعی — مرورهای نام‌دار کارشناس
// دیگر وابسته به مرورگر نیستند؛ API با fallback فایل، سازگاری نسخه نمایشی را حفظ می‌کند.
model MazarReview {
  id         String   @id @default(cuid())
  photoKey   String   @unique // کلید یکتای تصویر: `${martyrId}|${photoUrl}`
  martyrId   String
  verdict    String // approved | rejected | needs-more | context
  reviewer   String // نام کارشناس مرورکننده
  note       String?
  reviewedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([martyrId])
}
